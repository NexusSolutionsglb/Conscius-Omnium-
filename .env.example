# ─────────────────────────────────────────────────────────────
#  CONSCIOUS OMNIUM — environment
#  Copy to `.env.local` and fill in. The site runs WITHOUT any of
#  these (bundled portfolio content is used as a fallback), but the
#  Admin CMS, image uploads and enquiry emails require Supabase +
#  Resend to be configured.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, OG tags, email links.
# Leave it as localhost for development. A production build that is still
# pointed at localhost falls back to https://www.consciusomnium.com so
# canonicals and OG tags are never published as localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key (either name works, either env var name works).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # alias, if that's what your dashboard shows
# Server-only. NEVER expose to the browser. Used by Route handlers and
# the seed script for privileged writes. ("service_role" or "secret" key.)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=                    # alias

# ── Resend (transactional email) ────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# The verified "from" address, e.g. "Conscious Omnium <studio@consciousomnium.com>"
RESEND_FROM="Conscious Omnium <onboarding@resend.dev>"
# Where new enquiries are delivered (the artist's inbox).
INQUIRY_NOTIFY_EMAIL=architectshivjeet@gmail.com

# ── WhatsApp ────────────────────────────────────────────────
# International format, digits only (country code + number). No "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=919972910950

# ── Optional: Google Search Console ─────────────────────────
# The token from the "HTML tag" verification method (content="…" only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Optional: analytics ─────────────────────────────────────
# GA4 sets cookies, so enabling NEXT_PUBLIC_GA_ID also switches on a
# consent prompt. Plausible is cookieless and needs no prompt.
# Leave blank to disable. Supports a GA4 id (G-XXXXXXX) or a Plausible domain.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Optional: on-demand revalidation ────────────────────────
# A shared secret the Admin uses to purge the public cache after edits.
REVALIDATE_SECRET=
